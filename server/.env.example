# Copy to .env and adjust. All values have sane defaults for local dev.

# Port to listen on (0 = ephemeral, useful for tests)
PORT=3000

# Secret used to sign JWTs. REQUIRED in production — the server refuses to
# feel good about itself and logs a warning if this is missing.
JWT_SECRET=change-me-to-a-long-random-string

# Max size of a single uploaded file. Plain bytes or a unit suffix (e.g. 20MB, 2GB).
MAX_FILE_SIZE=20MB

# Where the SQLite database file lives
DB_PATH=./data/chat.db

# Where uploaded files / avatars / chunk temp dirs live
UPLOAD_DIR=./uploads

# Comma-separated list of allowed frontend origins for CORS (empty = allow all)
CLIENT_URL=http://localhost:5173
